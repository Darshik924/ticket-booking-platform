// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// ----------------------------------USER--------------------------------------
model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique 
  passwordHash String
  createdAt DateTime @default(now())

  bookings Booking[] // This relation is present in booking schema
}
// User --> Booking One to many relationship as one user has multiple bookings


// ----------------------------------Events------------------------------------
enum SeatStatus {
  AVAILABLE
  LOCKED       // We will keep this in redis and Pending payment work will start
  BOOKED       // confirmed in DB that the seat has been booked
}

model Event {
  id Int @id @default(autoincrement())
  name String
  venue String
  date DateTime
  totalSeats Int
  createdAt DateTime @default(now())
  seats Seat[]
}

// Event --> Seat again One to Many relationship

model Seat {
  id Int @id @default(autoincrement())
  eventId Int
  seatNumber String
  status      SeatStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  
  event Event @relation(fields: [eventId], references: [id])
  booking Booking? // Relation to booking is in the Booking schema
  // If booking may be null over here we do not need to have booking

  @@unique([eventId, seatNumber])
  @@index([eventId, status]) // Speeds up queries filtering by event and seat status
}

// Seat to Booking One to One relationship, for now we keep one seat only for one booking


// ------------------------------Booking-------------------------------------
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Booking {
  id Int @id @default(autoincrement())
  userId Int 
  seatId Int @unique
  status BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user User @relation(fields: [userId], references: [id])
  seat Seat @relation(fields: [seatId], references: [id])
}

// Booking --> User + Seat Many to One relationship, One booking belongs to one user and one seat